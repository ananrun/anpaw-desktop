{
  "name": "anpaw-desktop",
  "version": "1.0.0",
  "description": "harness desktop",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --dir",
    "make": "electron-builder",
    "make:win": "electron-builder --win nsis",
    "make:linux": "electron-builder --linux",
    "make:linux:deb": "electron-builder --linux deb",
    "make:linux:rpm": "electron-builder --linux rpm",
    "make:linux:x64": "electron-builder --linux --x64",
    "make:linux:arm64": "electron-builder --linux --arm64",
    "make:linux:deb:x64": "electron-builder --linux deb --x64",
    "make:linux:deb:arm64": "electron-builder --linux deb --arm64",
    "make:linux:rpm:x64": "electron-builder --linux rpm --x64",
    "make:linux:rpm:arm64": "electron-builder --linux rpm --arm64",
    "make:mac": "electron-builder --mac zip",
    "make:mac:x64": "electron-builder --mac zip --x64",
    "make:mac:arm64": "electron-builder --mac zip --arm64",
    "make:mac:universal": "electron-builder --mac zip --universal",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.changan.anpaw",
    "productName": "anpaw-desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "preload.js",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "renderer/resources/logo-zhua.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "zip"
      ]
    },
    "linux": {
      "target": [
        "deb",
        "rpm"
      ]
    }
  },
  "author": "chang-an",
  "license": "ISC",
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  }
}
