{
  "name": "anpaw-desktop",
  "version": "1.0.0",
  "description": "harness desktop",
  "main": "build/main/index.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && npm run build:electron && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "esbuild main/index.js --bundle --platform=node --target=node22 --external:electron --minify --outfile=build/main/index.cjs && esbuild preload.js --bundle --platform=node --target=node22 --external:electron --minify --outfile=build/preload.cjs",
    "lint": "eslint renderer/src",
    "format": "prettier --write \"renderer/**/*.{css,html,js,jsx,less}\" \"*.{js,json}\"",
    "format:check": "prettier --check \"renderer/**/*.{css,html,js,jsx,less}\" \"*.{js,json}\"",
    "check": "npm run lint && npm run format:check",
    "make:win": "npm run build && electron-builder --win nsis",
    "make:linux": "npm run build && electron-builder --linux",
    "make:mac": "npm run build && electron-builder --mac zip"
  },
  "build": {
    "appId": "com.changan.anpaw",
    "productName": "anpaw-desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**/*",
      "renderer/dist/**/*",
      "renderer/resources/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "renderer/resources/logo-zhua.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "zip"
      ]
    },
    "linux": {
      "target": [
        "deb",
        "rpm"
      ]
    }
  },
  "author": "chang-an",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "less": "^4.9.1",
    "prettier": "^3.9.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "vite": "^7.3.1",
    "wait-on": "^9.0.1"
  }
}
